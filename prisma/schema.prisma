// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADM
}

enum BookStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PROCESSING
  APROVED
  IN_DELIVERY
  DELIVERED
  CANCELED
}

model User {
  id        String   @id @unique @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  telephone String   @unique
  role      UserRole

  authors    Author[]
  categories Category[]
  orders     Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id          String @id @unique @default(uuid())
  name        String
  nationality String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model Book {
  id          String     @id @unique @default(uuid())
  title       String
  synopisis   String
  releaseDate DateTime
  price       Float
  quantity    Int
  status      BookStatus @default(ACTIVE)
  code        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  BookCategory[]
  orderItem OrderItem[]

  author   Author? @relation(fields: [authorId], references: [id])
  authorId String?
}

model Category {
  id   String @id @unique @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookCategory BookCategory[]

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}

model BookCategory {
  id String @id @unique @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book       Book?     @relation(fields: [bookId], references: [id])
  bookId     String?
  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?
}

model Order {
  id         String      @id @unique @default(uuid())
  totalPrice Float
  status     OrderStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  OrderItem[]
  user   User?       @relation(fields: [userId], references: [id])
  userId String?
}

model OrderItem {
  id         String @id @unique @default(uuid())
  quantity   Int
  unityPrice Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book    Book?   @relation(fields: [bookId], references: [id])
  bookId  String?
  order   Order?  @relation(fields: [orderId], references: [id])
  orderId String?
}
